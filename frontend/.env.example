# Base URL for the FastAPI backend (src/helpers/backend.py). In dev, leave
# unset/as-is to use the built-in mock at /api (see vite.config.js) when the
# real backend isn't running. To hit the real backend instead - started
# with `uvicorn backend:app --port 8000` from src/helpers - point this at it:
# VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=/api
